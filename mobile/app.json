{
  "expo": {
    "name": "ZINC",
    "slug": "zinc-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/zinc-icon.png",
    "scheme": "zinc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zinc.coach",
      "supportsTablet": true
    },
    "android": {
      "package": "com.zinc.coach",
      "adaptiveIcon": {
        "backgroundColor": "#126bc5",
        "foregroundImage": "./assets/images/zinc-splash.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/zinc-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#063774",
          "image": "./assets/images/zinc-splash.png",
          "imageWidth": 160
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
